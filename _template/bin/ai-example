#!/usr/bin/env python3
"""ai example: the template's command. Its parser is the only argument definition and answers --help."""
import argparse
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(prog='ai example', description='Template command: say hello, or save a greeting.')
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('hello', help='print a greeting (read-only)')
    save = commands.add_parser('save', help='write a greeting to ~/work/outputs/example/')
    save.add_argument('name')
    args = parser.parse_args()
    if args.command == 'hello':
        print('hello from the template')
        return 0
    if not args.name or args.name in ('.', '..') or '/' in args.name or '\\' in args.name or ':' in args.name:
        parser.error('name must be a plain output name without path separators')
    out = Path.home() / 'work/outputs/example'
    out.mkdir(parents=True, exist_ok=True)
    target = out / f'{args.name}.txt'
    if not target.resolve().is_relative_to(out.resolve()) or target.is_symlink():
        parser.error('output destination escapes the example output folder')
    target.write_text(f'hello, {args.name}\n')
    print(out / f'{args.name}.txt')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
