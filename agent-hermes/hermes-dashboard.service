[Unit]
Description=Hermes dashboard (127.0.0.1; on demand: ai dashboard; needs internet OFF)
# Not started by "ai start"/"ai up" without names: an agent interface starts only on request.
X-EVA-OnDemand=yes

[Service]
EnvironmentFile=-/opt/ai/setup/sandbox.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HERMES_DISABLE_LAZY_INSTALLS=1 UV_OFFLINE=1 PIP_NO_INDEX=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
# Reuse the platform's network wall; never toggle it or acquire dependencies on launch.
ExecStartPre=/usr/bin/systemctl is-active -q net-off
ExecStartPre=/usr/bin/systemctl --no-ask-password start eva-netcheck
ExecStartPre=/bin/sh -c '! curl -s -m 5 -o /dev/null https://1.1.1.1'
ExecStartPre=/usr/bin/python3 -B %h/.local/share/modules/agent-hermes/hermes_profile_check.py
ExecStart=/bin/sh -c 'cd "$HOME/work" && exec hermes dashboard --no-open --host 127.0.0.1 --port "${HERMES_DASH_PORT:-9119}"'
Restart=on-failure
RestartSec=5
