#!/usr/bin/env bash
## @brief No arguments lists chat models; list/show/verify uses the shared read-only inventory.
set -o pipefail
case "${1:-}" in
  help|-h|--help) echo 'ai models [list [--all] [--details] [--json] | show ID [--json] | verify ID [--json] | accept ID --record FILE | declared --json]
Bare command and declared work with llama-swap alone. list/show/verify/accept require the optional models.catalogue/1 provider (comfyui).'; exit 0 ;;
  declared)   # this module's chat declarations and their installed resolution, for the shared inventory (read-only)
    MOD=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
    exec python3 -B -c 'import json, os, sys
m = sys.argv[1]; r = os.path.join(m, "models", "models.json")
print(json.dumps({"chat": json.load(open(os.path.join(m, "models.json")))["chat"],
                  "resolved": json.load(open(r)) if os.path.exists(r) else {}}))' "$MOD" ;;
  list|show|verify|accept)
    command -v ai-model-catalogue >/dev/null || { echo 'CHECK shared model inventory needs the comfyui module' >&2; exit 1; }
    exec ai-model-catalogue "$@" ;;
  '') ;;
  *) echo "Unknown ai models command: $1 (ai models --help)" >&2; exit 2 ;;
esac
curl -s "http://127.0.0.1:${LLM_PORT:-8080}/v1/models" | python3 -c 'import json,sys; [print("  "+m["id"]) for m in json.load(sys.stdin)["data"]]'
