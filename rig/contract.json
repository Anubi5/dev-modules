{
  "schema_version": 1,
  "id": "humanoid-unreal-v1",
  "status": "reference-100k-profile-validated",
  "scope": "Adult fictional humanoids; creatures require a separate contract",
  "required_bones": [
    "root", "pelvis", "spine_01", "spine_02", "spine_03", "neck_01", "head",
    "clavicle_l", "upperarm_l", "lowerarm_l", "hand_l",
    "clavicle_r", "upperarm_r", "lowerarm_r", "hand_r",
    "thumb_01_l", "thumb_02_l", "thumb_03_l", "index_01_l", "index_02_l", "index_03_l",
    "middle_01_l", "middle_02_l", "middle_03_l", "ring_01_l", "ring_02_l", "ring_03_l",
    "pinky_01_l", "pinky_02_l", "pinky_03_l",
    "thumb_01_r", "thumb_02_r", "thumb_03_r", "index_01_r", "index_02_r", "index_03_r",
    "middle_01_r", "middle_02_r", "middle_03_r", "ring_01_r", "ring_02_r", "ring_03_r",
    "pinky_01_r", "pinky_02_r", "pinky_03_r",
    "thigh_l", "calf_l", "foot_l", "ball_l", "thigh_r", "calf_r", "foot_r", "ball_r"
  ],
  "naming": {"case": "lowercase", "left_suffix": "_l", "right_suffix": "_r", "unique": true},
  "hierarchy": {"single_root": "root", "root_deforms": false, "pelvis_parent": "root", "allow_extra_bones": true},
  "pose": {"bind": "A-pose", "export_test_actions": false, "left_right_reference_alignment_min": 0.9},
  "units": {"scene": "cm", "gltf": "metres", "metres_per_scene_unit": 0.01, "object_transforms_applied": true,
            "default_height_m": 1.7, "height_tolerance_m": 0.005},
  "weights": {"max_influences": 4, "all_character_vertices_weighted": true, "sum_tolerance": 0.0001},
  "mesh": {"character_meshes_only": true, "bone_display_meshes_excluded": true, "uv_required": true,
           "materials_required": true, "default_triangle_budget": 100000, "max_triangles": 100000,
           "candidate_budgets": [50000, 100000], "decimate_before_rigging": true},
  "fbx": {"encoding": "binary", "sdk_compatibility_reference": "Autodesk FBX SDK 2020.2",
          "blender_intermediate_binary_version": 7400, "preferred_unreal_export_compatibility": "FBX_2020",
          "unreal_import_acceptance_required": true, "animation_export_includes_preview_mesh": true,
          "preview_mesh_requires_renderer": true},
  "validation": {"edge_p95_max_exclusive": 1.5, "edge_p999_max_exclusive": 2.5,
                 "triangle_area_p01_min_exclusive": 0.2, "animation_measure_every_frame": true,
                 "moving_frame_fraction_min": 0.5, "render_coverage_min": 0.02},
  "records": ["contract_sha256", "input_sha256", "prepared_mesh_sha256", "source_revision",
              "checkpoint_sha256", "seed", "runtime_versions", "settings", "peak_vram_mib",
              "stage_results", "output_sha256", "validation_results"]
}
